# ---- LLM (any LangChain provider:model) ----
LLM_MODEL=google_genai:gemini-3.8-flash
GOOGLE_API_KEY=
# LLM_MODEL=anthropic:claude-sonnet-4-5
ANTHROPIC_API_KEY=
# LLM_MODEL=openai:gpt-4.1
# Free tiers:
# LLM_MODEL=groq:openai/gpt-oss-120b           # key: console.groq.com/keys
# GROQ_API_KEY=
# OPENAI_API_KEY=
# Local, no quota (brew install ollama && ollama pull qwen3:8b):
# LLM_MODEL=ollama:qwen3:8b

# ---- Backends: mock | swytch  (per-service override wins) ----
BACKEND=mock
# BACKEND_PAYPAL=swytch
# BACKEND_NOTION=swytch
# BACKEND_GMAIL=swytch
# BACKEND_JIRA=swytch
# BACKEND_SLACK=swytch

# ---- Notion (share the pages/databases with your Notion integration) ----
NOTION_PLAYBOOK_PAGE_ID=
NOTION_ORDERS_DB_ID=
NOTION_CASES_DB_ID=
# NOTION_TOKEN=            # only if `swy auth connect notion` isn't available

# ---- Jira ----
JIRA_PROJECT_KEY=OPS
JIRA_ISSUE_TYPE=Task
# JIRA_EMAIL=              # only if Swytchcode doesn't manage Jira auth
# JIRA_API_TOKEN=

# ---- Slack ----
# SLACK_TOKEN=             # xoxb-... only if `swy auth connect slack` isn't available

# ---- Demo safety ----
DEMO_EMAIL_OVERRIDE=you@gmail.com     # all emails land in your inbox
SLACK_CHANNEL_OVERRIDE=               # e.g. C0123456 (channel id) if names fail

# ---- Swytchcode tool-id overrides (check `swy list methods`) ----
# SWY_PAYPAL_LIST_INVOICES=paypal.invoices.list
# SWY_SLACK_POST_MESSAGE=slack.chat.postMessage

# ---- PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# SWY_DRY_RUN=1   # print requests instead of sending them
